# Local development only. Copy to .env (ignored by Git).
# For POSTGRES_* use unquoted letters/digits/underscore/hyphen so Docker Compose
# dotenv and Spring's .properties loader interpret them identically.
POSTGRES_DB=overload_dev
POSTGRES_USER=overload_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Email OTP is disabled until configured and live sending is explicitly approved.
OTP_EMAIL_ENABLED=false
RESEND_API_KEY=
# A bare verified sender address, without display-name formatting or quotes.
RESEND_FROM_EMAIL=
# Base64 encoding of at least 32 random bytes; never commit a real value.
OTP_HMAC_KEY=
