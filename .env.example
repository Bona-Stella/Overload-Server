# Local development only. Copy to .env (ignored by Git).
# For POSTGRES_* use unquoted letters/digits/underscore/hyphen so Docker Compose
# dotenv and Spring's .properties loader interpret them identically.
POSTGRES_DB=overload_dev
POSTGRES_USER=overload_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Email OTP is disabled until configured and live sending is explicitly approved.
OTP_EMAIL_ENABLED=false
# Controls EMAIL LOGIN only; common REAUTH/contact OTP remain independent.
EMAIL_LOGIN_ENABLED=true
RESEND_API_KEY=
# A bare verified sender address, without display-name formatting or quotes.
RESEND_FROM_EMAIL=
# Base64 encoding of at least 32 random bytes; never commit a real value.
OTP_HMAC_KEY=

# Google OIDC is opt-in; never put real client credentials in this template.
GOOGLE_OIDC_ENABLED=false
# Experimental Google auth_time evidence only; independent of LOGIN/contact confirmation.
GOOGLE_REAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# local defaults to http://localhost:8080/login/oauth2/code/google exactly.
# Non-local profiles require an explicit HTTPS callback at the same path.
GOOGLE_REDIRECT_URI=
# Optional Google LOGIN-only PWA return. Empty preserves the existing JSON success/failure routes.
# local: http://localhost:3000/auth/complete exactly; non-local: trusted HTTPS origin at /auth/complete.
# Failure uses the same configured origin at /auth/failed. No request returnUrl/next is accepted.
AUTH_FRONTEND_RETURN_URI=
